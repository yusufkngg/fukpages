{
  "name": "fukpages",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --use-system-ca server/index.mjs",
    "owner:setup": "node scripts/set-owner.mjs",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/*.mjs\" \"netlify/functions/*.mjs\" \"scripts/*.mjs\" \"tests/*.{mjs,ts}\"",
    "test:browser": "python tests/browser_smoke.py && python tests/browser_editor.py && python tests/browser_templates.py && python tests/browser_pages.py && python tests/browser_interactions.py && python tests/browser_studio.py && python tests/browser_reliability.py && python tests/browser_critical.py && python tests/browser_sections_quality.py && node scripts/netlify-context.mjs && python tests/browser_netlify.py",
    "test:network": "node --use-env-proxy --use-system-ca tests/remote_media_smoke.mjs",
    "test:responsive": "python tests/browser_responsive.py",
    "test:feedback": "python tests/browser_feedback.py",
    "test:netlify": "node scripts/build-sanitizer.mjs && node scripts/netlify-context.mjs && node --no-experimental-require-module scripts/check-netlify.mjs",
    "build:netlify": "npm run build && node scripts/netlify-context.mjs",
    "prebuild": "node scripts/build-sanitizer.mjs",
    "predev": "node scripts/build-sanitizer.mjs",
    "pretest": "node scripts/build-sanitizer.mjs",
    "prestart": "node scripts/build-sanitizer.mjs --if-missing",
    "test:ui": "python tests/browser_ui.py",
    "test:atomic": "python tests/browser_atomic.py",
    "test:editor": "python tests/browser_editor.py",
    "test:templates": "python tests/browser_templates.py",
    "test:pages": "python tests/browser_pages.py",
    "test:interactions": "python tests/browser_interactions.py",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@netlify/blobs": "11.1.4",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "fontkit": "2.0.4",
    "jsonc-parser": "3.3.1",
    "lucide-react": "0.468.0",
    "multer": "2.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "2.18.0",
    "serverless-http": "4.0.0",
    "sharp": "0.35.5",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "16.3.0",
    "@types/fontkit": "2.0.9",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

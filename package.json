{
  "name": "fukpages",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --use-env-proxy --use-system-ca server/index.mjs",
    "owner:setup": "node scripts/set-owner.mjs",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/*.mjs\" \"scripts/*.mjs\" \"tests/*.{mjs,ts}\"",
    "test:browser": "python tests/browser_smoke.py && python tests/browser_studio.py",
    "test:network": "node --use-env-proxy --use-system-ca tests/remote_media_smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "fontkit": "2.0.4",
    "jsonc-parser": "3.3.1",
    "lucide-react": "0.468.0",
    "multer": "2.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
